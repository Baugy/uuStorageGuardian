# Netlify Redirects for API Proxy
# This file handles API requests and proxies them to backend
# Note: For full proxy functionality, use Netlify Functions (requires Git deployment)

# API Proxy redirects (fallback if functions not available)
/api/boxes/* /.netlify/functions/api-proxy/api/boxes/:splat 200
/api/devices/* /.netlify/functions/api-proxy/api/devices/:splat 200
/api/warehouses /.netlify/functions/api-proxy/api/warehouses 200

# SPA routing - must be last
/* /index.html 200



